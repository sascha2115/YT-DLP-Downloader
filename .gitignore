# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]

# Virtual environments
.venv/
venv/

# PyInstaller build outputs
build/
dist/

# Commit stamped into the bundle by build-macos.sh / build-linux.sh. Written
# just before pyinstaller runs and removed on exit, so it is build output and
# must never be committed - a stale hash here would be reported as the build's.
BUILD_COMMIT

# Downloaded media: local library, hundreds of MB, never committed
media/

# CMake artifacts from yt-dlp's deno JS challenge solver
.build/

# Editor tooling artifacts
.groupedtimelineinclude

# Temporary commit message files
.git_commit_msg.txt
check_syntax.py
